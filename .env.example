SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GROQ_API_KEY=gsk_your-groq-api-key
# Optional: Drive folder ID for issue photos (uploads to Drive root if unset)
GOOGLE_DRIVE_FOLDER_ID=

# Slack user ID cc'd on Medium/Critical issues. Omit to disable the cc line.
ESCALATION_USER_ID=U0123456789

# Slack channel ID that CloudWatch alarms are posted to.
ALARM_CHANNEL=C0123456789
