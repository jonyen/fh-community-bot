SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Bedrock inference profile for the LLM calls (AWS credentials come from the
# default chain). Defaults to Claude Haiku 4.5.
LLM_MODEL_ID=
# Optional: Drive folder ID for issue photos (uploads to Drive root if unset)
GOOGLE_DRIVE_FOLDER_ID=

# Slack user ID cc'd on Medium/Critical issues. Omit to disable the cc line.
ESCALATION_USER_ID=U0123456789

# Slack channel ID that CloudWatch alarms are posted to.
ALARM_CHANNEL=C0123456789

# CREA (landlord) Rent Manager tenant portal. :ticket: reactions file nothing
# unless CREA_TICKETS_ENABLED=true and the login is set.
CREA_TICKETS_ENABLED=false
CREA_TWA_USERNAME=
CREA_TWA_PASSWORD=
CREA_TWA_PHONE=
# May a technician enter when nobody is present? true/false (default false)
CREA_TWA_ALLOW_ENTRY=false
# Comma-separated Slack user IDs allowed to file CREA tickets. Empty = nobody.
CREA_TICKET_USER_IDS=
