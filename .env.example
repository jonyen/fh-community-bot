SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C0123456789
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
ANTHROPIC_API_KEY=sk-ant-...
# Anthropic model id for the LLM calls. Defaults to Claude Haiku 4.5.
LLM_MODEL_ID=
# Optional: Drive folder ID for issue photos (uploads to Drive root if unset)
GOOGLE_DRIVE_FOLDER_ID=

# Slack user ID cc'd on Medium/Critical issues. Omit to disable the cc line.
ESCALATION_USER_ID=U0123456789

# Slack channel ID that CloudWatch alarms are posted to.
ALARM_CHANNEL=C0123456789

# CREA (landlord) Rent Manager tenant portal. :ticket: reactions file nothing
# unless CREA_TICKETS_ENABLED=true and the login is set.
CREA_TICKETS_ENABLED=false
CREA_TWA_USERNAME=
CREA_TWA_PASSWORD=
CREA_TWA_PHONE=
# May a technician enter when nobody is present? true/false (default false)
CREA_TWA_ALLOW_ENTRY=false
# Comma-separated Slack user IDs allowed to file CREA tickets. Empty = nobody.
CREA_TICKET_USER_IDS=

# #reservations (optional). Off unless RESERVATIONS_CHANNEL_ID is set; each
# backend is off unless its id (or the calendar map) is set.
RESERVATIONS_CHANNEL_ID=
ROOM_REQUESTS_SHEET_ID=1F70ce8Gd1JEvjXTsBIeV0PBi85Ii3ggf2z1tFIh1Eg4
KITCHEN_SHEET_ID=1xUA0EG95241Ndb3HBOLw-iYGxU9nBTswzFn8ob49o5c
# JSON map "resource name" -> resource calendar id (raw or base64). In CI it
# ships as runtime-config/resource-calendars.json instead.
RESOURCE_CALENDARS=
# false = equipment bookings reply with the calendar link instead of writing.
RMS_BOOKING_ENABLED=true

# Connected Google accounts (optional). Web OAuth client from the acts2.network
# GCP project; the redirect URI is the OAuthRedirectUri stack output.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
AUTH_TABLE=fh-community-reservations-auth
AUTH_KMS_KEY_ID=

# Basketball roll-call channels, comma-separated. Empty turns it off.
BBALL_CHANNEL_IDS=
